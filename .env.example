# Embedding backend: "st" (sentence-transformers, multilingual, best quality)
# or "tfidf" (no downloads, runs fully offline — good for a quick demo).
VLEARN_EMBED=st

# Optional — set to have Claude synthesize the answer from retrieved context.
# Leave empty to use the built-in extractive summary (still fully grounded).
ANTHROPIC_API_KEY=
VLEARN_MODEL=claude-sonnet-4-6
